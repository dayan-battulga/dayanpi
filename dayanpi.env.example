# Copy to /etc/dayanpi.env on the Pi, then:
#   sudo chmod 600 /etc/dayanpi.env
#   sudo chown root:root /etc/dayanpi.env
#
# Do NOT commit real credentials.

DAYANPI_USER=changeme
DAYANPI_PASSWORD=changeme

# Optional. Where the focus log and other data go (default: data/ next to app.py).
# DAYANPI_DATA_DIR=/home/dayoon/dayanpi-data

# Optional. The voice (see MANUAL.md "Voice"): off (default), espeak or piper.
# DAYANPI_VOICE=off
# DAYANPI_PIPER_MODEL=/home/dayoon/piper-voices/en_US-lessac-medium.onnx
# DAYANPI_AUDIO_DEVICE=plughw:CARD=Device,DEV=0
