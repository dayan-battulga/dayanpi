[Unit]
Description=dayanpi host telemetry dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=dayoon
WorkingDirectory=/home/dayoon/Desktop/site-page/dayanpi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/dayanpi.env
ExecStart=/home/dayoon/Desktop/site-page/dayanpi/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
