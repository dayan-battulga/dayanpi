# Copy to /etc/dayanpi.env on the Pi, then:
#   sudo chmod 600 /etc/dayanpi.env
#   sudo chown root:root /etc/dayanpi.env
#
# Do NOT commit real credentials.

# Your owner account. These only make it the first time the app starts with no
# data/accounts.db. After that you sign in with them, and once you change your
# password in Settings, this one stops working (it's only used again if
# accounts.db is gone). Startup still fails without them, so keep them here,
# and keep the password a strong one.
DAYANPI_USER=changeme
DAYANPI_PASSWORD=changeme

# Your Tailscale login, exactly as Tailscale shows it (see docs/MANUAL.md, Camera lock).
# With it set, /video and /video/side only answer you (the owner) on your own Tailscale
# devices, and everyone else gets a 404, including people who come in through Funnel.
# Set this before you ever turn on Funnel.
# DAYANPI_TAILSCALE_LOGIN=you@github

# Optional. Where the focus log and other data go (default: data/ at the repo root).
# DAYANPI_DATA_DIR=/home/dayoon/dayanpi-data

# Optional. The voice (see docs/voice.md): off (default) or piper.
# DAYANPI_VOICE=off
# DAYANPI_PIPER_MODEL=/home/dayoon/piper-voices/en_US-lessac-medium.onnx
# DAYANPI_AUDIO_DEVICE=plughw:CARD=Device,DEV=0
# What the peace sign says (see docs/voice.md): a small Ollama model to write the message
# (unset means the fixed template). Your bedtime is in Settings → Voice and bedtime.
# DAYANPI_LLM_MODEL=llama3.2:1b

# Optional. Which camera (see docs/pi-camera.md): auto (default), usb, picamera,
# or both (one in front, the other on the side).
# DAYANPI_CAMERA=auto
# With both, which camera faces you: usb (default) or picamera. The other one goes on the side.
# DAYANPI_FRONT_CAMERA=usb
# Only if you have two webcams and it finds the wrong one.
# DAYANPI_USB_DEVICE=/dev/v4l/by-id/usb-YOUR_WEBCAM-video-index0
# Pi camera mounted upside down? 180 flips it (the webcam is never flipped). 0 is the default.
# DAYANPI_PICAMERA_ROTATION=0

# Optional. Smooth video on the room's seats (see docs/MANUAL.md, Smooth video): off unless this
# says on. Then everyone's browser sends their camera straight to the others with WebRTC and finds
# them through Cloudflare's free STUN server (stun.cloudflare.com, no account). Without it, seats
# show a picture a second and nothing outside the Pi is used.
# DAYANPI_SMOOTH_VIDEO=on
# Optional, needs the line above too. A Cloudflare TURN key, for networks that block direct
# connections: with both set, the Pi asks Cloudflare for short-lived relay credentials (its only
# outside call). Keep the token secret: it never leaves the Pi.
# DAYANPI_TURN_KEY_ID=your-turn-key-id
# DAYANPI_TURN_API_TOKEN=your-turn-api-token
