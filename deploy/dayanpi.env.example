# Copy to /etc/dayanpi.env on the Pi, then:
#   sudo chmod 600 /etc/dayanpi.env
#   sudo chown root:root /etc/dayanpi.env
#
# Do NOT commit real credentials.

DAYANPI_USER=changeme
DAYANPI_PASSWORD=changeme

# Optional. Where the focus log and other data go (default: data/ at the repo root).
# DAYANPI_DATA_DIR=/home/dayoon/dayanpi-data

# Optional. The voice (see docs/MANUAL.md "Voice"): off (default), espeak or piper.
# DAYANPI_VOICE=off
# DAYANPI_PIPER_MODEL=/home/dayoon/piper-voices/en_US-lessac-medium.onnx
# DAYANPI_AUDIO_DEVICE=plughw:CARD=Device,DEV=0

# Optional. Which camera (see docs/MANUAL.md "Pi camera"): auto (default), usb or picamera.
# DAYANPI_CAMERA=auto
# DAYANPI_USB_DEVICE=/dev/v4l/by-id/usb-YOUR_WEBCAM-video-index0

# Optional. The LED sign (see docs/MANUAL.md "LED sign"): preview (default, website only), panel or off.
# With panel, the motors stay off: the Matrix Bonnet uses the motor pins.
# DAYANPI_SIGN=preview
